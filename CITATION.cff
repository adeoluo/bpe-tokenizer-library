cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "BPE Tokenizer Library"
abstract: "A byte-level BPE tokenizer implementing the GPT-2 algorithm, with a Rust core (PyO3) used by default that matches its Python reference token for token; lossless for any input and faster than tiktoken in batch."
authors:
  - family-names: "Ogunnoiki"
    given-names: "Adeolu"
version: "0.4.1"
date-released: "2026-11-08"
license: MIT
repository-code: "https://github.com/adeoluo/bpe-tokenizer-library"
url: "https://github.com/adeoluo/bpe-tokenizer-library"
keywords:
  - "bpe"
  - "byte-pair-encoding"
  - "gpt-2"
  - "language-model"
  - "nlp"
  - "python"
  - "tokenizer"
  - "pyo3"
  - "rust"
  - "from-scratch"
