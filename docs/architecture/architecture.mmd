flowchart LR
    Corpus[(Corpus)] --> Trainer["Trainer<br/>most frequent pair"]
    Trainer --> Merges[(Ordered merges)]
    App([Caller]) -->|text or ids| API["BPETokenizer<br/>Python API"]
    Merges -.-> API
    API --> Select{"backend<br/>available?"}
    Select -->|rust| PyO3["PyO3 bindings<br/>bpe_tokenizer_rs"]
    PyO3 --> Rust["Rust core<br/>pretokenize, byte map, merges"]
    Select -->|fallback| Py["Python implementation<br/>re, byte map, merge ranks"]
    Rust --> Out["Token ids or text"]
    Py --> Out
    Parity["Parity tests<br/>identical ids and text"] -.- Rust
    Parity -.- Py
