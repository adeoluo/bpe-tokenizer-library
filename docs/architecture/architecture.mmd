flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Caller([Python caller]):::edge
        CLI(["CLI<br/>train, encode, serve"]):::edge
        Router["Router<br/>/encode, /decode, /stats"]:::edge
        Validate["Validation<br/>text length, id range"]:::control
        Caller ~~~ CLI --> Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Corpus[("Training corpus<br/>sample + held-out")]:::data
        Merges[("Ordered merges<br/>vocab, ranks, JSON")]:::data
        Tables[("Unicode tables<br/>14.0 to 16.0")]:::data
        Corpus --> Merges ~~~ Tables
    end

    subgraph Core["Tokenizer core"]
        direction TB
        API["BPETokenizer<br/>train, encode, decode"]:::core
        Select{"Rust available?<br/>Unicode version match"}:::control
        Py["Python backend<br/>trainer + encoder"]:::core
        Rust["Rust core via PyO3<br/>bpe_tokenizer_rs"]:::core
        API --> Select
        Select -->|fallback| Py
        Select -->|rust| Rust
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Reports["Reports<br/>compression, round trip"]:::obs
        Parity["Parity tests<br/>same ids and text"]:::obs
        Compare["compare.py<br/>Python, Rust, tiktoken"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Reports ~~~ Parity ~~~ Compare ~~~ Metrics
    end

    Interfaces -->|text or ids| Core
    State -.->|merges, tables| Core
    Core -->|ids or text| Obs
